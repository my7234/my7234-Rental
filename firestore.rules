rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.email == "apk723424@gmail.com" && request.auth.token.email_verified == true;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email'])
        && data.uid == request.auth.uid;
    }

    function isValidProperty(data) {
      return data.keys().hasAll(['title', 'type', 'stories', 'rooms', 'bathrooms', 'country', 'city', 'area', 'address', 'hasGas', 'hasElectricity', 'phone', 'whatsapp', 'currency', 'language', 'imageUrls', 'isAvailable', 'createdAt', 'ownerEmail', 'ownerUid'])
        && data.keys().size() == 20
        && data.title is string && data.title.size() <= 200
        && data.type in ['Home', 'Shop', 'Apartment']
        && data.stories in ['Single', 'Double']
        && data.rooms is string && data.rooms.size() <= 10
        && data.bathrooms is string && data.bathrooms.size() <= 10
        && data.country is string && data.country.size() <= 10
        && data.city is string && data.city.size() <= 100
        && data.area is string && data.area.size() <= 100
        && data.address is string && data.address.size() <= 500
        && data.hasGas is bool
        && data.hasElectricity is bool
        && data.phone is string && data.phone.size() <= 30
        && data.whatsapp is string && data.whatsapp.size() <= 30
        && data.currency is string && data.currency.size() <= 10
        && data.language is string && data.language.size() <= 100
        && data.imageUrls is list && data.imageUrls.size() <= 3
        && data.isAvailable is bool
        && data.createdAt is int
        && data.ownerEmail is string
        && data.ownerUid == request.auth.uid;
    }

    match /properties/{propertyId} {
      // Publicly viewable listings
      allow list: if true;
      allow get: if isValidId(propertyId);

      allow create: if isVerified() && isValidProperty(incoming());
      
      allow update: if isVerified() 
        && (isAdmin() || (isOwner(existing().ownerUid)
        && isValidProperty(incoming())
        && incoming().ownerUid == existing().ownerUid
        && incoming().createdAt == existing().createdAt));

      allow delete: if (isVerified() && isOwner(existing().ownerUid) && isValidId(propertyId)) || isAdmin();
    }

    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      allow create, update: if isOwner(userId) && isValidUser(incoming());
    }
  }
}
